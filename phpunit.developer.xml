<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites><testsuite name="DeveloperPortal">
        <file>tests/Feature/Developer/DeveloperPortalTest.php</file>
        <file>tests/Feature/Developer/OAuthClientControllerTest.php</file>
        <file>tests/Feature/Developer/OAuthNativeClientFlowTest.php</file>
        <file>tests/Feature/AuthSessionTest.php</file>
    </testsuite></testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="15432" force="true"/>
        <env name="DB_DATABASE" value="kulsah_developer_testing" force="true"/>
        <env name="DB_USERNAME" value="postgres" force="true"/>
        <env name="DB_PASSWORD" value="developer_testing_only" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Most storage fakes contain placeholder bytes, not probeable videos. -->
        <env name="VIDEO_INSPECT_DIRECT_UPLOADS" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="FASTAPI_ENABLED" value="false"/>
    </php>
</phpunit>

